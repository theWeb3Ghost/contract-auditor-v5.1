# MongoDB connection string (required)
# Get one at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/contract_auditor?retryWrites=true&w=majority

# Python binary path (default: python3)
PYTHON_BIN=python3

# Path to the evolution orchestrator Python script (required for source fetching / decompilation)
# Default: <project_root>/learner/evolution_orchestrator.py (bundled in v5.1)
# To use an external orchestrator, set this to your custom path.
EVOLUTION_ORCHESTRATOR_PATH=

# Path to the Porcelain-X Rust decompiler binary (optional)
# Used when contract source is not verified on Etherscan.
# If noc
# Enable orchestrator debug logging to /tmp/orchestrator_debug_*.md
# Set to 1 to enable, 0 or unset to disable
ORCHESTRATOR_DEBUG=1

# Log level (optional, default: info)
LOG_LEVEL=info

# Etherscan V2 API key (optional — can also be passed via x-etherscan-key header)
# ETHERSCAN_API_KEY=your_etherscan_api_key_here
